# ============================
# Server configuration
# ============================
PORT=                # Port number the backend server runs on (e.g. 8080)
NODE_ENV=development # Use production in deployed environments

# ============================
# Database
# ============================
MONGODB_URI=         # MongoDB connection string (Atlas or local)
MONGO_INITDB_ROOT_USERNAME= # Used only by local docker-compose MongoDB
MONGO_INITDB_ROOT_PASSWORD= # Used only by local docker-compose MongoDB

# ============================
# JWT tokens
# ============================
JWT_REFRESH_SECRET=  # Secret key for refresh tokens
JWT_REFRESH_EXPIRED= # Refresh token expiration (e.g. 7d)
JWT_ACCESS_SECRET=   # Secret key for access tokens
JWT_ACCESS_EXPIRED=  # Access token expiration (e.g. 15m)
JWT_RESET_PASSWORD_SECRET= # Required in production; dedicated reset-token secret
JWT_RESET_PASSWORD_EXPIRE= # Password reset token expiration (e.g. 10m)

# ============================
# Email verification
# ============================
JWT_EMAIL_VERIFY_SECRET= # Secret for email verification tokens
JWT_EMAIL_VERIFY_EXPIRE= # Expiration for email verification token (e.g. 10m)

# ============================
# URLs
# ============================
BACKEND_BASE_URL=    # Base URL of backend API (e.g. http://localhost:8080)
FRONTEND_URL=        # Allowed CORS origin (e.g. http://localhost:3000)
TRUST_PROXY=1        # Number of trusted reverse proxies (usually 1 on a PaaS)

# ============================
# Mailer (SMTP)
# ============================
MAIL_HOST=           # SMTP server host
MAIL_PORT=           # SMTP port (usually 465 or 587)
MAIL_USER=           # SMTP username
MAIL_PASS=           # SMTP password
MAIL_FROM=           # Default sender email address (e.g. no-reply@domain.com)
OTP_FORGOT_PASSWORD_EXPIRE= # OTP expiration in minutes (e.g. 5)
RESEND_API_KEY=      # Optional: use Resend HTTP API instead of SMTP

# ============================
# Rate limiting
# ============================
RATE_LIMIT_DEFAULT_TTL=   # Window length in minutes (e.g. 1)
RATE_LIMIT_DEFAULT_LIMIT= # Max number of requests per window (e.g. 60)

# ============================
# AI abuse protection and retention
# ============================
AI_QUOTA_SALT=            # Random secret used to anonymize quota identities
AI_DAILY_GUEST_LIMIT=5    # Daily generation attempts per guest IP
AI_DAILY_USER_LIMIT=20    # Daily generation attempts per authenticated user
GUEST_PLAN_TTL_HOURS=72   # Guest plans expire automatically
EXTERNAL_REQUEST_TIMEOUT_MS=25000 # Timeout for Gemini and email requests

# ============================
# Google Gemini AI
# ============================
GEMINI_API_KEY=           # API Key from https://aistudio.google.com/
GEMINI_MODEL=gemini-3.5-flash-lite # Cost-efficient GA model with a free tier
